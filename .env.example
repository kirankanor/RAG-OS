# Copy this file to .env and fill in whatever cloud strategies you plan to use.
# Local strategies (txt_plain parser, all chunkers, local_minilm embedder, faiss_flat_l2 /
# hybrid_bm25_vector retrievers) need none of these.

OPENAI_API_KEY=
COHERE_API_KEY=

# Only needed if you use the "qdrant" retrieval strategy against a remote/cloud instance.
# For a local Qdrant (e.g. via `docker run -p 6333:6333 qdrant/qdrant`), the default below is fine.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
